<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_Glass.GlassPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Jarvis_Glass"
    mc:Ignorable="d">

    <!--
        Two tiers, both live in this one control so consumers never change based on which is
        active. Tier B "system glass": SystemBackdropElement (Acrylic, from the OS compositor) —
        the always-present safety net. Tier A "shader glass": LiquidGlassCanvas, a Win2D
        CanvasControl drawn on top when GlassQuality allows it, carrying the material itself —
        body gradient, top light, pointer-tracked sheen, grain and bevel. Tier B gets the same
        idea in the cheap form available to it: acrylic, a tint, and a gradient rim. When Tier A
        is on it owns the tint and rim, so the two Borders below step aside rather than stacking
        a second dim layer over a material that already has one.
    -->
    <Grid x:Name="RootGrid" CornerRadius="{x:Bind GlassCornerRadius, Mode=OneWay}">
        <Grid.Resources>
            <!--
                Tier B's edge. A single flat hairline is what a card has; running the highlight
                from a lit top-left corner down to a nearly dark bottom-right is what reads as a
                bevel. Tier A draws its own richer rim on the canvas and hides this one.
            -->
            <LinearGradientBrush x:Key="RimGradient" StartPoint="0,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#66FFFFFF" />
                <GradientStop Offset="0.35" Color="#26FFFFFF" />
                <GradientStop Offset="1" Color="#0FFFFFFF" />
            </LinearGradientBrush>
        </Grid.Resources>

        <SystemBackdropElement x:Name="Backdrop" CornerRadius="{x:Bind GlassCornerRadius, Mode=OneWay}">
            <SystemBackdropElement.SystemBackdrop>
                <DesktopAcrylicBackdrop />
            </SystemBackdropElement.SystemBackdrop>
        </SystemBackdropElement>

        <local:LiquidGlassCanvas
            x:Name="ShaderCanvas"
            GlassCornerRadius="{x:Bind GlassCornerRadius.TopLeft, Mode=OneWay}"
            Visibility="Collapsed" />

        <Border
            x:Name="TintOverlay"
            CornerRadius="{x:Bind GlassCornerRadius, Mode=OneWay}"
            Background="{x:Bind TintBrush, Mode=OneWay}" />

        <Border
            x:Name="RimBorder"
            CornerRadius="{x:Bind GlassCornerRadius, Mode=OneWay}"
            BorderThickness="1"
            BorderBrush="{StaticResource RimGradient}" />

        <ContentPresenter
            x:Name="ContentHost"
            Content="{x:Bind GlassContent, Mode=OneWay}"
            Padding="{x:Bind ContentPadding, Mode=OneWay}" />
    </Grid>
</UserControl>
