<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.ToolStepCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Expander x:Name="Root" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0">
        <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE90F;" FontSize="12" Foreground="#94A3B8" />
                <TextBlock x:Name="ToolName" FontSize="12" Foreground="#E2E8F0" />
                <Border x:Name="StatusBadge" CornerRadius="8" Padding="6,1">
                    <TextBlock x:Name="StatusText" FontSize="10" />
                </Border>
            </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="6" Padding="4">
            <TextBlock Text="Arguments" FontSize="10" Foreground="#64748B" />
            <TextBlock x:Name="ArgsText" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
            <TextBlock x:Name="ResultLabel" Text="Result" FontSize="10" Foreground="#64748B" />
            <TextBlock x:Name="ResultText" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
        </StackPanel>
    </Expander>
</UserControl>
