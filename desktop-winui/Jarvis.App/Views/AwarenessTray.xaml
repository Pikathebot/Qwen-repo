<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.AwarenessTray"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Jarvis.Core.Models"
    xmlns:local="using:Jarvis_App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Port of AwarenessTray.tsx: bottom-right stack of dismissible severity-coded cards. -->
    <UserControl.Resources>
        <local:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <local:SeverityToBackgroundConverter x:Key="SeverityToBackground" />
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8" Width="320">
        <TextBlock
            x:Name="DismissAllLink"
            Text=""
            Foreground="#94A3B8"
            FontSize="11"
            HorizontalAlignment="Right"
            Tapped="DismissAll_Tapped" />
        <ItemsControl x:Name="ObservationsList" ItemsSource="{x:Bind ViewModel.Observations, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Observation">
                    <Border
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10"
                        BorderBrush="{x:Bind Severity, Converter={StaticResource SeverityToBrush}}"
                        Background="{x:Bind Severity, Converter={StaticResource SeverityToBackground}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                Width="8"
                                Height="8"
                                Margin="0,4,8,0"
                                VerticalAlignment="Top"
                                Fill="{x:Bind Severity, Converter={StaticResource SeverityToBrush}}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Detail}" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Content="✕"
                                FontSize="10"
                                Padding="4"
                                Background="Transparent"
                                BorderThickness="0"
                                Tag="{x:Bind}"
                                Click="DismissObservation_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
