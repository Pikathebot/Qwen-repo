# Active Model Backend ("bonsai" | "hermes3")
ACTIVE_MODEL_BACKEND=bonsai

# LM Studio Configuration (Stage B Default)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=prism-ml/bonsai-27b

# Ollama Service Configuration (Rollback Target)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=hermes3:8b

# Server Configuration
APP_HOST=127.0.0.1
APP_PORT=8000

# Resource Governor Thresholds
GOVERNOR_ENABLED=true
GOVERNOR_POLL_INTERVAL=1.0
GOVERNOR_GPU_THRESHOLD=85.0
GOVERNOR_VRAM_THRESHOLD=90.0
GOVERNOR_CPU_THRESHOLD=90.0
GOVERNOR_RAM_THRESHOLD=92.0
GOVERNOR_QUEUE_TIMEOUT_SECONDS=3.0

# OpenRouter Heavy Mode Configuration
OPENROUTER_API_KEY=
OPENROUTER_HEAVY_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_ROUTING_MODE=auto

# Memory & Compaction Configuration
MEMORY_DB_PATH=data/jarvis_memory.db
MEMORY_MAX_CONTEXT_TOKENS=16000
MEMORY_TOOL_PRUNING_CHAR_THRESHOLD=200
